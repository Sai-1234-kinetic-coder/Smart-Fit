# Copy this file to `.env` and fill in the values from your Firebase project
# (Firebase Console → Project settings → General → Your apps → SDK setup and config).
VITE_APP_NAME=AuraFit
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Gemini API key for the real "Ask Aura" AI companion.
# Get one at https://aistudio.google.com/apikey
# NOTE: this ships inside the browser bundle — fine for a small trusted
# group, but don't use this pattern for a public production app (proxy
# through a backend instead so the key stays server-side).
VITE_GEMINI_API_KEY=
